# Copy to /etc/flare-nrt/flare.env (systemd EnvironmentFile). No secrets needed.
FLARE_DATA_DIR=
FLARE_WEIGHTS=
FLARE_WEIGHTS_SHA256=
FLARE_NORM_STATS=

# Detection (calibrated values; change only with a new validation, docs/model-card.md)
FLARE_LAG_MIN=8
FLARE_N_BASELINE=3
FLARE_THRESHOLD=0.80
FLARE_MERGE_GAP_MIN=10

# Runtime
FLARE_TORCH_THREADS=4
FLARE_POLL_SEC=60
FLARE_STALE_AFTER_SEC=600
FLARE_MAX_INPUT_AGE_SEC=3600
FLARE_GIVE_UP_MIN=120
FLARE_SKIP_AFTER_MIN=20

# Retention (docs/archive-format.md)
FLARE_STAGING_DAYS=3
FLARE_ARCHIVE_LOCAL_DAYS=14
FLARE_MIN_FREE_GB=10
