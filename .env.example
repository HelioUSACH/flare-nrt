# Copy to /etc/flare-nrt/flare-nrt.env (systemd EnvironmentFile). No secrets are
# needed; every value below has a default (flare_nrt/config.py), set only what
# you change.
FLARE_NRT_DATA_DIR=
FLARE_NRT_WEIGHTS=
FLARE_NRT_NORM_STATS=
# pinned to the release asset by default; set only with a new release
FLARE_NRT_WEIGHTS_SHA256=

# Detection (calibrated values; change only with a new validation, docs/model-card.md)
FLARE_NRT_LAG_MIN=
FLARE_NRT_N_BASELINE=
FLARE_NRT_MIN_BASELINE=
FLARE_NRT_THRESHOLD=
FLARE_NRT_MERGE_GAP_MIN=

# Input and freshness
FLARE_NRT_JSOC_BASE=
FLARE_NRT_POLL_SEC=
FLARE_NRT_ARCHIVE_EVERY_SEC=
FLARE_NRT_ARCHIVE_BUDGET_SEC=
FLARE_NRT_LOOKBACK_MIN=
FLARE_NRT_STALE_AFTER_SEC=
FLARE_NRT_MAX_INPUT_AGE_SEC=
FLARE_NRT_TORCH_THREADS=

# Retention (flare_nrt/retention.py)
FLARE_NRT_STAGING_DAYS=
FLARE_NRT_TENSORS_DAYS=
FLARE_NRT_GRADCAM_DAYS=
FLARE_NRT_GRADCAM_ALERT_DAYS=
FLARE_NRT_ARCHIVE_LOCAL_DAYS=
FLARE_NRT_RESULTS_DAYS=
FLARE_NRT_MIN_FREE_GB=
