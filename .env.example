# Copy to /etc/centella/centella.env (systemd EnvironmentFile). No secrets needed.
CENTELLA_DATA_DIR=
CENTELLA_WEIGHTS=
CENTELLA_WEIGHTS_SHA256=
CENTELLA_NORM_STATS=

# Detection (calibrated values; change only with a new validation, docs/model-card.md)
CENTELLA_LAG_MIN=8
CENTELLA_N_BASELINE=3
CENTELLA_THRESHOLD=0.80
CENTELLA_MERGE_GAP_MIN=10

# Runtime
CENTELLA_TORCH_THREADS=4
CENTELLA_POLL_SEC=60
CENTELLA_STALE_AFTER_SEC=600
CENTELLA_MAX_INPUT_AGE_SEC=3600
CENTELLA_GIVE_UP_MIN=120
CENTELLA_SKIP_AFTER_MIN=20

# Retention (docs/archive-format.md)
CENTELLA_STAGING_DAYS=3
CENTELLA_ARCHIVE_LOCAL_DAYS=14
CENTELLA_MIN_FREE_GB=10
