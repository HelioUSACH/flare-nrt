# Copy to /etc/centella/centella.env (systemd EnvironmentFile). No secrets are
# needed; every value below has a default (centella/config.py), set only what
# you change.
CENTELLA_DATA_DIR=
CENTELLA_WEIGHTS=
CENTELLA_NORM_STATS=
# pinned to the release asset by default; set only with a new release
CENTELLA_WEIGHTS_SHA256=

# Detection (calibrated values; change only with a new validation, docs/model-card.md)
CENTELLA_LAG_MIN=
CENTELLA_N_BASELINE=
CENTELLA_MIN_BASELINE=
CENTELLA_THRESHOLD=
CENTELLA_MERGE_GAP_MIN=

# Input and freshness
CENTELLA_JSOC_BASE=
CENTELLA_POLL_SEC=
CENTELLA_ARCHIVE_EVERY_SEC=
CENTELLA_ARCHIVE_BUDGET_SEC=
CENTELLA_LOOKBACK_MIN=
CENTELLA_STALE_AFTER_SEC=
CENTELLA_MAX_INPUT_AGE_SEC=
CENTELLA_TORCH_THREADS=

# Retention (centella/retention.py)
CENTELLA_STAGING_DAYS=
CENTELLA_TENSORS_DAYS=
CENTELLA_GRADCAM_DAYS=
CENTELLA_GRADCAM_ALERT_DAYS=
CENTELLA_ARCHIVE_LOCAL_DAYS=
CENTELLA_RESULTS_DAYS=
CENTELLA_MIN_FREE_GB=
