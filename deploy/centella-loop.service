# Example unit (checklist F.29). The maintainers install it; paths are settings.
[Unit]
Description=Centella detection loop (AIA synoptic → usach.flare.nrt)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=centella
Group=centella
WorkingDirectory=/opt/centella
EnvironmentFile=/etc/centella/centella.env
ExecStart=/opt/centella/.venv/bin/python -m centella.loop
Restart=always
RestartSec=30
# CPU budget on a shared VM (docs: INTEGRATION.md "Resources")
CPUQuota=200%
MemoryMax=4G
Nice=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/centella
PrivateTmp=true

[Install]
WantedBy=multi-user.target
