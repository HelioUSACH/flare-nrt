# Example unit: the status API the portal polls (127.0.0.1 only).
[Unit]
Description=flare-nrt status API (127.0.0.1:5050)
After=network.target

[Service]
Type=simple
User=flare
Group=flare
WorkingDirectory=/opt/flare-nrt
EnvironmentFile=/etc/flare-nrt/flare.env
ExecStart=/opt/flare-nrt/.venv/bin/uvicorn flare_nrt.server:app --host 127.0.0.1 --port 5050 --workers 1
Restart=always
RestartSec=5
MemoryMax=512M
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/srv/flare-nrt
PrivateTmp=true

[Install]
WantedBy=multi-user.target
