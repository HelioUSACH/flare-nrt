# Example unit: weekly operational validation against GOES (last 7 days).
[Unit]
Description=Centella weekly validation vs GOES

[Service]
Type=oneshot
User=centella
Group=centella
WorkingDirectory=/opt/centella
EnvironmentFile=/etc/centella/centella.env
ExecStart=/bin/bash -c '/opt/centella/.venv/bin/python -m centella.validate \
  --start "$(date -u -d "7 days ago" +%%F)" --end "$(date -u -d yesterday +%%F)" \
  --out "/srv/centella/reports/validation_$(date -u +%%F).json"'
Nice=10
CPUQuota=100%
MemoryMax=1G
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/centella
