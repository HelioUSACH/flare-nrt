# Example unit (checklist F.29). The maintainers install it; paths are settings.
[Unit]
Description=flare-nrt detection loop (AIA synoptic → usach.flare.nrt)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flare-nrt
Group=flare-nrt
WorkingDirectory=/opt/flare-nrt
EnvironmentFile=/etc/flare-nrt/flare-nrt.env
ExecStart=/opt/flare-nrt/.venv/bin/python -m flare_nrt.loop
# logs go to stdout/stderr → journald (journalctl -u flare-nrt-loop)
Restart=always
RestartSec=30
# Budget on the shared server (measured: ~1.2 GB peak RSS, ~21 s CPU per
# frame on 2 vCPU incl. Grad-CAM; INTEGRATION.md "Resources")
CPUQuota=200%
MemoryMax=3G
Nice=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/flare-nrt
PrivateTmp=true

[Install]
WantedBy=multi-user.target
