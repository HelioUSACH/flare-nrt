diff --git a/web/static/web/js/flare-explore.js b/web/static/web/js/flare-explore.js
new file mode 100644
index 0000000..492852d
--- /dev/null
+++ b/web/static/web/js/flare-explore.js
@@ -0,0 +1,420 @@
+/* Explorar (usach.flare.nrt, model Centella): the flare page driven by a
+ * time cursor. Reads the portal's own proxies of a Centella API
+ * (views.flare_archive_json / flare_image / flare_gradcam; config in the
+ * #fx-config JSON). Timeline in vendored ECharts (no build step, no CDN,
+ * D-002); everything else is plain DOM. State lives in the URL hash so a
+ * link reopens the same instant. */
+(function () {
+  "use strict";
+
+  var cfgEl = document.getElementById("fx-config");
+  if (!cfgEl) return;
+  var CFG = JSON.parse(cfgEl.textContent);
+  var T = CFG.i18n, U = CFG.urls;
+  var WAVES = [131, 171, 304, 1600];
+  var MIN = 60e3;
+  var $ = function (id) { return document.getElementById(id); };
+
+  var S = {
+    all: [], frames: [], idx: 0, events: [], flares: [], thr: 0.8,
+    kind: "img", disk: "img", playing: false, timer: null, req: 0,
+    t0: 0, t1: 0, range: null, chart: null,
+  };
+
+  // ---- formatting ----------------------------------------------------------
+  function iso(ms) { return new Date(ms).toISOString().slice(0, 19) + "Z"; }
+  function pad(n) { return n < 10 ? "0" + n : "" + n; }
+  var MONTHS = CFG.lang === "en" ? ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
+    : ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
+  function hm(ms) { var d = new Date(ms); return pad(d.getUTCHours()) + ":" + pad(d.getUTCMinutes()); }
+  function dayLabel(ms) { var d = new Date(ms); return pad(d.getUTCDate()) + "-" + MONTHS[d.getUTCMonth()]; }
+  function dt(ms) { return dayLabel(ms) + " " + hm(ms); }
+  function num(v, digits) {
