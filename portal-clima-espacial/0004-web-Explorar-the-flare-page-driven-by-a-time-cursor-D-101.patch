+{% extends "web/base.html" %}
+{% load i18n static %}
+{% block title %}{{ title }}{% endblock %}
+{% comment %}
+  Explorar (usach.flare.nrt, model Centella): the flare page driven by a time
+  cursor over any period the archive source holds (views.flare_explore;
+  FLARE_ARCHIVE_URL, the live service by default). Data and images come
+  through the portal's own proxies (views.flare_archive_json, flare_image,
+  flare_gradcam); behaviour in web/static/web/js/flare-explore.js.
+{% endcomment %}
+{% block content %}
+<div class="wrap flare-page fx" id="fx">
+  <div class="crumb"><a href="{% url 'web:catalogue' %}">{% trans "Productos y modelos" %}</a> / <a href="{% url 'web:product_detail' product.id %}">{% trans "Detección de flares (NRT)" %}</a> / {% trans "Explorar" %}</div>
+  <div class="eyebrow">{% trans "Modelo Centella" %} · {{ product.id }}</div>
+  <h1>{{ title }}</h1>
+  <p class="fx-lead">{% trans "Recorre cualquier período instante a instante: qué vio Centella en los cuatro canales de AIA, qué probabilidad dio y cómo se compara con las flares que registró GOES." %}</p>
+  <div class="badges">
+    <span class="pill">{% if archive_is_live %}{% trans "Fuente: servicio en vivo" %}{% else %}{% trans "Fuente: archivo (replay)" %}{% endif %}</span>
+    <span class="pill" id="fx-range">…</span>
+    <a class="pill" href="{% url 'web:product_detail' product.id %}">← {% trans "Volver a ahora" %}</a>
+  </div>
+
+  <section class="fx-bar" aria-label="{% trans 'Período' %}">
+    <label>{% trans "Desde (UT)" %} <input type="datetime-local" id="fx-start" step="120"></label>
+    <label>{% trans "Ventana" %}
+      <select id="fx-span">
+        <option value="0.25">6 h</option><option value="1" selected>{% trans "1 día" %}</option>
+        <option value="3">{% trans "3 días" %}</option><option value="7">{% trans "7 días" %}</option>
+        <option value="30">{% trans "30 días" %}</option><option value="40">{% trans "40 días" %}</option>
+      </select>
+    </label>
+    <button type="button" class="fx-btn" id="fx-load">{% trans "Cargar" %}</button>
+    <button type="button" class="fx-btn" id="fx-all">{% trans "Todo el período" %}</button>
+    <span class="fx-msg" id="fx-msg" role="status"></span>
+  </section>
+
+  <section class="sec fx-timeline" aria-labelledby="fx-tl-h">
+    <div class="sec-head"><div><div class="eyebrow" id="fx-tl-eyebrow">—</div><h2 id="fx-tl-h">{% trans "Probabilidad y flares GOES" %}</h2></div></div>
+    <figure class="flare-chart fx-chart">
+      <div id="fx-chart" class="fx-chart__plot" role="img" aria-label="{% trans 'Probabilidad de Centella en el período, con las flares de GOES y los eventos detectados' %}"></div>
+      <figcaption class="flare-chart__legend">
+        <span><i class="k-prob"></i>{% trans "Probabilidad (Centella)" %}</span>
+        <span><i class="k-thr"></i>{% trans "Umbral de alerta" %}</span>
+        <span><i class="fx-k fx-k--ev"></i>{% trans "Evento Centella" %}</span>
+        <span><i class="fx-k fx-k--c"></i>GOES C</span><span><i class="fx-k fx-k--m"></i>GOES M</span><span><i class="fx-k fx-k--x"></i>GOES X</span>
+        <span>{% trans "Rueda: zoom · arrastrar: mover · clic: ir a ese instante" %}</span>
+      </figcaption>
+      <div class="fx-transport">
+        <b class="fx-now" id="fx-now">—</b>
+        <button type="button" class="fx-btn" id="fx-evprev" title="{% trans 'Evento o flare anterior (J)' %}">⏮</button>
+        <button type="button" class="fx-btn" id="fx-prev" title="{% trans 'Instante anterior (←)' %}">◀</button>
+        <button type="button" class="fx-btn fx-btn--play" id="fx-play" title="{% trans 'Reproducir (espacio)' %}">▶</button>
+        <button type="button" class="fx-btn" id="fx-next" title="{% trans 'Instante siguiente (→)' %}">▶▏</button>
+        <button type="button" class="fx-btn" id="fx-evnext" title="{% trans 'Evento o flare siguiente (K)' %}">⏭</button>
+        <select id="fx-fps" aria-label="{% trans 'Velocidad' %}"><option value="1">1 fps</option><option value="2" selected>2 fps</option><option value="4">4 fps</option></select>
+        <input type="range" id="fx-scrub" min="0" max="0" value="0" aria-label="{% trans 'Instante' %}">
+        <label class="fx-check"><input type="checkbox" id="fx-okonly"> {% trans "solo instantes con resultado" %}</label>
+      </div>
+    </figure>
+  </section>
+
+  <section class="flare-hero" aria-label="{% trans 'Estado en el instante elegido' %}">
+    <div class="flare-now" id="fx-state" role="status">
+      <div class="eyebrow" id="fx-state-eyebrow">—</div>
+      <h2><span class="flare-dot" aria-hidden="true"></span><span id="fx-state-h">…</span></h2>
+      <div class="flare-meter" id="fx-meter">
+        <div class="flare-meter__head"><span>{% trans "Probabilidad del modelo" %}</span><b id="fx-p">—</b></div>
+        <div class="flare-meter__bar"><span class="flare-meter__fill" id="fx-fill" style="width: 0%"></span><span class="flare-meter__thr" id="fx-thr" style="left: 80%"></span></div>
+        <div class="flare-meter__legend"><span>0</span><span id="fx-thr-label">—</span><span>1</span></div>
+      </div>
+      <dl class="flare-facts">
+        <div><dt>{% trans "Observación AIA" %}</dt><dd id="fx-obs">—</dd></div>
+        <div><dt>{% trans "Comparado con" %}</dt><dd id="fx-bl">—</dd></div>
+        <div><dt>GOES</dt><dd id="fx-goes">—</dd></div>
+      </dl>
+      <p class="flare-note" id="fx-note"></p>
+    </div>
+
+    <figure class="flare-disk">
+      <div class="flare-disk__head fx-disk-head"><span class="eyebrow" id="fx-disk-label">AIA 131 Å</span>
+        <span class="seg" role="group"><button type="button" class="seg-link on" id="fx-disk-img">131 Å</button><button type="button" class="seg-link" id="fx-disk-cam">Grad-CAM</button></span></div>
+      <div class="flare-disk__img" id="fx-disk"><span class="flare-disk__mark" id="fx-mark" hidden></span></div>
+      <figcaption id="fx-disk-cap">{% trans "Ubicación experimental: la región de mayor aumento en 131 Å. Norte arriba, oeste a la derecha." %}</figcaption>
+    </figure>
+  </section>
+
+  <section class="sec" aria-labelledby="fx-sun-h">
+    <div class="sec-head">
+      <div><div class="eyebrow" id="fx-sun-eyebrow">AIA</div><h2 id="fx-sun-h">{% trans "El Sol en ese instante, en los 4 canales" %}</h2></div>
+      <div class="seg" role="group" aria-label="{% trans 'Qué mostrar' %}">
+        <button type="button" class="seg-link on" id="fx-k-img">{% trans "Imagen" %}</button>
+        <button type="button" class="seg-link" id="fx-k-diff">{% trans "Diferencia (lo que ve el modelo)" %}</button>
+      </div>
+    </div>
+    <div class="flare-channels">
+      {% for ch in channels %}
+      <figure class="flare-ch" data-wave="{{ ch.wave }}">
+        <div class="flare-ch__name">{{ ch.wave }} Å</div>
+        <div class="fx-ch-img"></div>
+        <figcaption><b>{{ ch.ion }}</b><span>{{ ch.what }}</span><span class="fx-tobs"></span></figcaption>
+      </figure>
+      {% endfor %}
+    </div>
+    <p class="flare-help" id="fx-help">{% trans "Imágenes synoptic de AIA, cada 2 minutos. Centella usa los cuatro canales a la vez." %}</p>
+  </section>
+
+  <div class="fx-lists">
+    <section class="sec" aria-labelledby="fx-ev-h">
+      <div class="sec-head"><div><div class="eyebrow">{% trans "Detecciones" %}</div><h2 id="fx-ev-h">{% trans "Eventos de Centella" %}</h2></div></div>
+      <div class="table-wrap flare-table"><table>
+        <thead><tr><th scope="col">{% trans "Inicio (UT)" %}</th><th scope="col">{% trans "Duración" %}</th><th scope="col">{% trans "Prob. máx." %}</th><th scope="col">{% trans "Flare GOES" %}</th></tr></thead>
+        <tbody id="fx-evs"></tbody>
+      </table></div>
+    </section>
+    <section class="sec" aria-labelledby="fx-fl-h">
+      <div class="sec-head"><div><div class="eyebrow">GOES</div><h2 id="fx-fl-h">{% trans "Flares registradas (C o mayor)" %}</h2></div></div>
+      <div class="table-wrap flare-table"><table>
+        <thead><tr><th scope="col">{% trans "Clase" %}</th><th scope="col">{% trans "Inicio (UT)" %}</th><th scope="col">{% trans "Pico" %}</th><th scope="col">Centella</th></tr></thead>
+        <tbody id="fx-fls"></tbody>
+      </table></div>
+    </section>
+  </div>
+  <p class="flare-help">{% trans "Una flare M o X cuenta como detectada si hay una alerta entre 10 minutos antes de su inicio y 5 minutos después de su fin. Un evento sin flare GOES (C o mayor) cerca es una falsa alarma." %} {% trans "Teclas: ← → un instante, Shift + ← → una hora, espacio reproduce, J / K salta entre eventos." %}</p>
+</div>
+{{ fx_config|json_script:"fx-config" }}
+{% endblock %}
+{% block extra_scripts %}<script defer src="{% static 'web/js/flare-explore.js' %}"></script>{% endblock %}
