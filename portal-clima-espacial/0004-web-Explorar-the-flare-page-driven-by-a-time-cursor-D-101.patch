+.fx-bar label { display: grid; gap: 4px; font-family: var(--font-ui); font-size: 12px; color: var(--ink-faint); }
+.fx-bar input, .fx-bar select, .fx-transport select { font-family: var(--font-mono); font-size: 13px; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 7px 9px; }
+.fx-btn { font-family: var(--font-ui); font-size: 13px; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 7px 12px; cursor: pointer; }
+.fx-btn:hover { border-color: var(--accent); }
+.fx-btn.on { background: var(--ink); color: var(--bg); border-color: var(--ink); }
+.fx-msg { font-size: 13px; color: var(--ink-soft); align-self: center; }
+.fx-chart { padding: 20px 24px 16px; }
+.fx-chart__plot { height: 260px; cursor: crosshair; }
+.flare-chart__legend .fx-k { border: 0; height: 9px; border-radius: 2px; }
+.fx-k--ev { background: var(--severity-strong-soft); }
+.fx-k--c { background: var(--ink-faint); opacity: .5; }
+.fx-k--m { background: var(--severity-moderate); }
+.fx-k--x { background: var(--severity-strong); }
+.fx-transport { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--grid); }
+.fx-now { font-family: var(--font-mono); font-size: 17px; font-weight: 500; margin-right: 6px; min-width: 150px; }
+.fx-transport input[type=range] { flex: 1 1 220px; accent-color: var(--accent); }
+.fx-check { font-family: var(--font-ui); font-size: 12.5px; color: var(--ink-soft); display: inline-flex; gap: 6px; align-items: center; }
+.fx-disk-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
