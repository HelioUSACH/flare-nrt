diff --git a/locale/en/LC_MESSAGES/django.po b/locale/en/LC_MESSAGES/django.po
index bd8448b..fbf2b4c 100644
--- a/locale/en/LC_MESSAGES/django.po
+++ b/locale/en/LC_MESSAGES/django.po
@@ -1248,3 +1248,8 @@ msgstr "Source and period"
 
 msgid "No se pudo leer Centella. ¿Está corriendo su API?"
 msgstr "Centella could not be read. Is its API running?"
+
+# flare box (D-102)
+
+msgid "El recuadro marca la región de mayor aumento en 131 Å (ubicación de Centella). Norte arriba, oeste a la derecha."
+msgstr "The box marks the region of largest increase at 131 Å (Centella's location). North up, west to the right."
diff --git a/web/flare_page.py b/web/flare_page.py
index dfe0763..b03e488 100644
--- a/web/flare_page.py
+++ b/web/flare_page.py
@@ -79,13 +79,29 @@ def _location_text(loc: dict | None, lang: str) -> str:
 AIA_HALF_FOV = 1024 * 2.4 / 2          # synoptic images: 1024 px × 2.4″, centred on the Sun
 
 
-def _disk_marker(loc: dict | None) -> dict | None:
-    """Percent position on Centella's preview (north up, west right) of a
-    helioprojective position in arcsec."""
+BOX_PAD = 30.0      # arcsec added around the detected region on each side
+BOX_MIN = 160.0     # arcsec: never smaller, so it reads even on the channel thumbnails
+
+
+def flare_box(loc: dict | None) -> dict | None:
+    """Square around the flare on Centella's previews (north up, west right),
+    as CSS percentages of the image: ``left``/``top`` of its corner and
+    ``size``. From the region's bounding box (Centella ≥ 2.5, ``bbox_arcsec``)
+    plus ``BOX_PAD``, else from its area around the centroid; at least
+    ``BOX_MIN`` wide. flare-page.js draws the same box (``boxFor``)."""
     if not loc or not loc.get("centroid_arcsec"):
         return None
-    x, y = loc["centroid_arcsec"]
-    return {"left": round(50 + x / AIA_HALF_FOV * 50, 1), "top": round(50 - y / AIA_HALF_FOV * 50, 1)}
+    bb = loc.get("bbox_arcsec")
