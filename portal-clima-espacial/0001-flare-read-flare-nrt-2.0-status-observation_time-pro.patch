@@ -51,16 +56,25 @@ def parse_status(raw: dict) -> dict | None:
     if not raw.get("timestamp"):
         return None
     issued = parse_time(raw["timestamp"])
-    return {
-        "issued": issued,
-        "valid_from": issued,
-        "payload": {
-            "probability": raw.get("probability", 0.0),
-            "flare_detected": bool(raw.get("flare_detected", False)),
-            "location": raw.get("location"),
-        },
-        "quality": {
-            "producer_live_status": live_status(raw),
-            "ensemble_std": raw.get("ensemble_std"),
-        },
+    observed = parse_time(raw["observation_time"]) if raw.get("observation_time") else issued
+    payload = {
+        "probability": raw.get("probability", 0.0),
+        "flare_detected": bool(raw.get("flare_detected", False)),
+        "location": raw.get("location"),
     }
+    for key in ("alert", "event_id"):
+        if key in raw:
+            payload[key] = raw[key]
+    quality = {
+        "producer_live_status": live_status(raw),
+        "ensemble_std": raw.get("ensemble_std"),
+    }
+    for key in ("model_version", "data_latency_s"):
+        if key in raw:
+            quality[key] = raw[key]
+    provenance = None
+    if raw.get("model_version"):
+        provenance = {"producer": f"flare-nrt@{raw['model_version']}",
+                      "inputs": [f"aia.synoptic {raw['observation_time']}"] if raw.get("observation_time") else []}
+    return {"issued": issued, "valid_from": observed, "payload": payload, "quality": quality,
+            "provenance": provenance}
