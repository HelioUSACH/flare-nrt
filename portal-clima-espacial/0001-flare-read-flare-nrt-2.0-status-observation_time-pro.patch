+def test_parse_status_v2_uses_observation_time():
+    # Synthetic payload in flare-nrt 2.0's /api/status shape.
+    parsed = adapters.parse_status(_load("status_live_v2.json"))
+    assert parsed["issued"] == dt.datetime(2026, 10, 27, 14, 16, 41, tzinfo=dt.UTC)
+    assert parsed["valid_from"] == dt.datetime(2026, 10, 27, 14, 2, tzinfo=dt.UTC)
+    assert parsed["payload"]["alert"] is True and parsed["payload"]["event_id"] == 7
+    assert parsed["quality"]["model_version"] == "2.0.0"
+    assert parsed["quality"]["data_latency_s"] == 881
+    assert parsed["provenance"]["producer"] == "flare-nrt@2.0.0"
+
+
+def test_parse_status_v1_shape_unchanged():
+    parsed = adapters.parse_status(_load("status_live.json"))
+    assert parsed["valid_from"] == parsed["issued"]
+    assert set(parsed["payload"]) == {"probability", "flare_detected", "location"}
+    assert parsed["provenance"] is None
+
+
 def test_parse_status_no_result_returns_none():
     assert adapters.parse_status(_load("status_no_result.json")) is None
 
