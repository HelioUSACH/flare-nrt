diff --git a/web/flare_page.py b/web/flare_page.py
index b03e488..65d0cea 100644
--- a/web/flare_page.py
+++ b/web/flare_page.py
@@ -66,14 +66,37 @@ def _xray_y(flux: float) -> float:
     return H - (v - lo) / (hi - lo) * H
 
 
-def _location_text(loc: dict | None, lang: str) -> str:
+def heliographic(x: float, y: float, when: dt.datetime | None = None) -> str:
+    """Helioprojective arcsec (north up, as in AIA level 1.5) → Stonyhurst
+    "N14 W31", with the Sun's apparent radius and B0 for the date (low-
+    precision ephemeris, good to ~1°). "" off the disk. flare-page.js has
+    the same function (``heliographic``)."""
+    when = when or timezone.now()
+    d = (when - dt.datetime(2000, 1, 1, 12, tzinfo=dt.UTC)).total_seconds() / 86400
+    g = math.radians(357.529 + 0.98560028 * d)                       # mean anomaly
+    r_au = 1.00014 - 0.01671 * math.cos(g) - 0.00014 * math.cos(2 * g)
+    radius = 959.63 / r_au
+    lam = math.radians(280.459 + 0.98564736 * d + 1.915 * math.sin(g))
+    node = math.radians(75.76 + 0.01397 * (when.year - 1850))
+    b0 = math.asin(math.sin(lam - node) * math.sin(math.radians(7.25)))
+    u, v = x / radius, y / radius
+    if u * u + v * v >= 1:
+        return ""
+    w = math.sqrt(1 - u * u - v * v)
+    lat = math.degrees(math.asin(v * math.cos(b0) + w * math.sin(b0)))
+    lon = math.degrees(math.atan2(u, w * math.cos(b0) - v * math.sin(b0)))
+    return f"{'N' if lat >= 0 else 'S'}{abs(lat):02.0f} {'W' if lon >= 0 else 'E'}{abs(lon):02.0f}"
+
+
+def _location_text(loc: dict | None, lang: str, when: dt.datetime | None = None) -> str:
     if not loc or not loc.get("centroid_arcsec"):
         return ""
     x, y = loc["centroid_arcsec"]
-    limb = ""
     if loc.get("on_limb"):
