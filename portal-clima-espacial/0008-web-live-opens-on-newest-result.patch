From 38a90f7d1e16fb5414880320b0171233c3be67ff Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 08:58:53 -0300
Subject: [PATCH] web: live flare page opens on the newest frame with a result

After a restart the newest slots are 'missing' while Centella catches up;
the page showed 'Sin imagen para este instante'. It now opens (and keeps
following) on the newest frame that has a result, which reads as 'Sin datos
recientes' when it is old.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019TiLZJK6V4V5hFsgBRSyAK
---
 web/static/web/js/flare-page.js | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/web/static/web/js/flare-page.js b/web/static/web/js/flare-page.js
index 873768f..3887b2a 100644
--- a/web/static/web/js/flare-page.js
+++ b/web/static/web/js/flare-page.js
@@ -214,7 +214,11 @@
       $("fx-thr-label").textContent = T.alert + " " + num(S.thr, 2);
       drawChart(); drawMonth(); srcLine();
       msg("");
-      var want = seekTo ? Date.parse(seekTo) : (S.frames.length ? S.frames[S.frames.length - 1].t : t0);
+      // with no instant asked for: the newest frame that has a result (the newest slots can still be
+      // "missing" while the loop catches up, e.g. after a restart), else simply the newest
+      var okF = S.frames.filter(function (f) { return f.status === "ok"; });
+      var newest = okF.length ? okF[okF.length - 1] : S.frames[S.frames.length - 1];
+      var want = seekTo ? Date.parse(seekTo) : (newest ? newest.t : t0);
       seek(want, true);
     }).catch(function () { msg(T.unreachable); });
   }
@@ -269,7 +273,8 @@
     if (i < 0 || !S.frames.length) { $("fx-now").textContent = T.no_data; $("fx-pos").textContent = ""; return; }
     S.idx = Math.max(0, Math.min(S.frames.length - 1, i));
     var last = S.idx === S.frames.length - 1;
-    if (!auto && live()) S.follow = last && S.t1 >= Date.now() - 5 * MIN;
+    var laterOk = S.frames.slice(S.idx + 1).some(function (x) { return x.status === "ok"; });
+    if (!auto && live()) S.follow = (last || !laterOk) && S.t1 >= Date.now() - 5 * MIN;
     $("fx-now-btn").classList.toggle("on", live() && S.follow);
     var f = S.frames[S.idx];
     $("fx-now").textContent = dtY(f.t);
-- 
2.43.0

