+def flare_image(request, wave):
+    """One AIA channel of Centella's latest result, proxied from the model's
+    own 127.0.0.1 endpoint (it is never exposed by nginx, ARCHITECTURE §6).
+    Cached 60 s: the model updates every 2 min. A model that is down gives
+    a 404 and the page shows the channel's placeholder."""
+    kind = "diff" if request.GET.get("tipo") == "diferencia" else "img"
+    if wave not in FLARE_WAVES:
+        return HttpResponse(status=404)
+    key = f"flare-image:{wave}:{kind}"
+    png = cache.get(key)
+    if png is None:
+        import httpx
+
+        from modules.flare import client
+        try:
+            r = httpx.get(f"{client.BASE_URL}/api/image/{wave}.png", params={"kind": kind}, timeout=client.TIMEOUT)
+        except httpx.HTTPError:
+            return HttpResponse(status=404)
+        if r.status_code != 200 or r.headers.get("content-type") != "image/png":
+            return HttpResponse(status=404)
+        png = r.content
+        cache.set(key, png, 60)
+    response = HttpResponse(png, content_type="image/png")
+    patch_cache_control(response, max_age=60, public=True)
+    return response
+
