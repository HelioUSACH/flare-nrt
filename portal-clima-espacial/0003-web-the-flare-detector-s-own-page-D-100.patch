+{% extends "web/base.html" %}
+{% load i18n l10n %}
+{% block title %}{{ title }}{% endblock %}
+{% comment %}
+  usach.flare.nrt's own page (model Centella, D-099; web/flare_page.py).
+  Reloads every 2 min, the model's cadence: plain meta refresh, no JS.
+{% endcomment %}
+{% block extra_head %}<meta http-equiv="refresh" content="120">{% endblock %}
+{% block content %}
+<div class="wrap flare-page">
+  <div class="crumb"><a href="{% url 'web:catalogue' %}">{% trans "Productos y modelos" %}</a> / {{ title }}</div>
+  <div class="eyebrow">{% trans "Modelo Centella" %} · {{ product.id }}</div>
+  <h1>{{ title }}</h1>
+  <div class="badges">
+    <span class="pill{% if status.status == 'ok' %} ok{% elif status.status == 'delayed' %} delayed{% endif %}"{% if status.title %} title="{{ status.title }}"{% endif %}><span class="dot" style="background:{{ status.color }}"></span>{{ status.label }}</span>
+    <span class="pill">{{ product.get_maturity_display }}</span>
+    <span class="pill">SDO/AIA · JSOC</span>
+  </div>
+
+  <section class="flare-hero" aria-label="{% trans 'Estado actual' %}">
+    <div class="flare-now flare-now--{{ flare.state }}" role="status">
+      <div class="eyebrow">{% if flare.state == "flare" %}{% trans "Ahora · evento abierto" %}{% else %}{% trans "Ahora" %}{% endif %}</div>
+      <h2><span class="flare-dot" aria-hidden="true"></span>
+        {% if flare.state == "flare" %}{% trans "Flare en curso" %}
+        {% elif flare.state == "quiet" %}{% trans "Sin flare en curso" %}
+        {% elif flare.state == "stale" %}{% trans "Datos con retraso" %}
+        {% else %}{% trans "En preparación" %}{% endif %}
+      </h2>
+      {% if flare.probability is not None %}
+      <div class="flare-meter">
+        <div class="flare-meter__head"><span>{% trans "Probabilidad del modelo" %}</span><b>{{ flare.probability|floatformat:2 }}</b></div>
+        <div class="flare-meter__bar"><span class="flare-meter__fill" style="width: {{ flare.probability_pct|unlocalize }}%"></span><span class="flare-meter__thr" style="left: {{ flare.threshold_pct|unlocalize }}%"></span></div>
+        <div class="flare-meter__legend"><span>0</span><span>{% blocktrans with t=flare.threshold|floatformat:2 %}umbral de alerta {{ t }}{% endblocktrans %}</span><span>1</span></div>
+      </div>
+      <dl class="flare-facts">
+        <div><dt>{% trans "Observación AIA" %}</dt><dd>{{ flare.observed|date:"d-M H:i" }} UT</dd></div>
+        <div><dt>{% trans "Retraso del dato" %}</dt><dd>{% if flare.latency_min is not None %}{{ flare.latency_min }} min{% else %}—{% endif %}</dd></div>
+        <div><dt>{% trans "Comparado con" %}</dt><dd>{% trans "8–12 min antes" %}</dd></div>
+      </dl>
+      {% else %}
+      <p>{% trans "El detector todavía no ha entregado resultados en este ambiente." %}</p>
+      {% endif %}
+      {% if flare.state == "flare" and flare.open_event %}
+      <p class="flare-note">{% blocktrans with t=flare.open_event.start|date:"H:i" %}Detectada desde las {{ t }} UT{% endblocktrans %}{% if flare.location %} · {{ flare.location }}{% endif %}. {% trans "La clase GOES se confirma al terminar la flare." %}</p>
+      {% elif flare.last_event %}
+      <p class="flare-note">{% trans "Último evento:" %} {% if flare.last_event.goes %}<b>{{ flare.last_event.goes }}</b>, {% endif %}{{ flare.last_event.start|date:"d-M H:i" }} UT{% if flare.last_event.location %}, {{ flare.last_event.location }}{% endif %}. <a href="#eventos">{% trans "Ver eventos" %} →</a></p>
+      {% endif %}
+    </div>
+
+    <figure class="flare-disk">
+      <div class="flare-disk__head"><span class="eyebrow">AIA 131 Å{% if flare.observed %} · {{ flare.observed|date:"H:i" }} UT{% endif %}</span></div>
+      <div class="flare-disk__img">
+        <img src="{% url 'web:flare_image' 131 %}" alt="{% trans 'Imagen más reciente del Sol en 131 Å' %}" width="512" height="512">
+        {% if flare.marker %}<span class="flare-disk__mark" style="left: {{ flare.marker.left|unlocalize }}%; top: {{ flare.marker.top|unlocalize }}%"></span>{% endif %}
+      </div>
+      <figcaption>{% trans "Ubicación experimental: la región de mayor aumento en 131 Å. Norte arriba, oeste a la derecha." %}</figcaption>
+    </figure>
+  </section>
+
+  <section class="sec" aria-labelledby="flare-sun-h">
+    <div class="sec-head">
+      <div><div class="eyebrow">AIA{% if flare.observed %} · {{ flare.observed|date:"d-M H:i" }} UT{% endif %}</div><h2 id="flare-sun-h">{% trans "El Sol ahora, en los 4 canales" %}</h2></div>
+      <div class="seg" role="group" aria-label="{% trans 'Qué mostrar' %}">
+        <a class="seg-link{% if flare.view == 'img' %} on{% endif %}" href="?vista=imagen" {% if flare.view == 'img' %}aria-current="true"{% endif %}>{% trans "Imagen" %}</a>
+        <a class="seg-link{% if flare.view == 'diff' %} on{% endif %}" href="?vista=diferencia" {% if flare.view == 'diff' %}aria-current="true"{% endif %}>{% trans "Diferencia (lo que ve el modelo)" %}</a>
+      </div>
+    </div>
+    <div class="flare-channels">
+      {% for ch in flare.channels %}
+      <figure class="flare-ch">
+        <div class="flare-ch__name">{{ ch.wave }} Å</div>
+        <img src="{% url 'web:flare_image' ch.wave %}{% if flare.view == 'diff' %}?tipo=diferencia{% endif %}" alt="{% blocktrans with w=ch.wave %}AIA {{ w }} Å{% endblocktrans %}" width="512" height="512" loading="lazy">
+        <figcaption><b>{{ ch.ion }}</b><span>{{ ch.what }}</span></figcaption>
+      </figure>
+      {% endfor %}
+    </div>
+    <p class="flare-help">{% if flare.view == 'diff' %}{% trans "Diferencia: la imagen actual menos el promedio de las de 8, 10 y 12 minutos antes, en cuentas por segundo. Lo que se ilumina aquí es lo que Centella evalúa." %}{% else %}{% trans "Imágenes synoptic de AIA, cada 2 minutos. Centella usa los cuatro canales a la vez." %}{% endif %}</p>
+  </section>
+
+  <section class="sec" aria-labelledby="flare-24-h">
+    <div class="sec-head"><div><div class="eyebrow">{% trans "Últimas 24 horas" %}</div><h2 id="flare-24-h">{% trans "Probabilidad y flujo GOES" %}</h2></div></div>
+    <figure class="flare-chart">
+      {% if flare.has_series %}
+      <div class="flare-chart__plot">
+        <svg viewBox="0 0 1000 200" preserveAspectRatio="none" role="img" aria-label="{% trans 'Probabilidad de Centella y flujo de rayos X de GOES en las últimas 24 horas' %}">
+          <g class="flare-chart__grid"><line x1="0" y1="0" x2="1000" y2="0"></line><line x1="0" y1="100" x2="1000" y2="100"></line><line x1="0" y1="200" x2="1000" y2="200"></line><line x1="250" y1="0" x2="250" y2="200"></line><line x1="500" y1="0" x2="500" y2="200"></line><line x1="750" y1="0" x2="750" y2="200"></line></g>
+          {% if flare.xray_path %}<path class="flare-chart__xray" d="{{ flare.xray_path }}"></path>{% endif %}
+          <line class="flare-chart__thr" x1="0" y1="{{ flare.threshold_y|unlocalize }}" x2="1000" y2="{{ flare.threshold_y|unlocalize }}"></line>
+          <path class="flare-chart__prob" d="{{ flare.prob_path }}"></path>
+        </svg>
+        <span class="flare-chart__y" style="top: -7px">1.0</span><span class="flare-chart__y" style="top: calc(50% - 7px)">0.5</span><span class="flare-chart__y" style="bottom: -7px">0</span>
+        {% for l in flare.xray_levels %}<span class="flare-chart__cls" style="top: calc({{ l.top|unlocalize }}% - 7px)">{{ l.label }}</span>{% endfor %}
+        {% for m in flare.event_marks %}<span class="flare-chart__ev" style="left: {{ m.left|unlocalize }}%">{{ m.label }}</span>{% endfor %}
+      </div>
+      <div class="flare-chart__x">{% for t in flare.ticks %}<span>{{ t.label }}</span>{% endfor %}</div>
+      <figcaption class="flare-chart__legend">
+        <span><i class="k-prob"></i>{% trans "Probabilidad (Centella)" %}</span>
+        <span><i class="k-xray"></i>{% trans "GOES rayos X 0,1–0,8 nm (escala A–X a la derecha)" %}</span>
+        <span><i class="k-thr"></i>{% trans "Umbral de alerta" %}</span>
+        <span>{% trans "Hora UT" %}</span>
+      </figcaption>
+      {% else %}
+      <p>{% trans "Todavía no hay resultados en las últimas 24 horas." %}</p>
+      {% endif %}
+    </figure>
+  </section>
+
+  <section class="sec" id="eventos" aria-labelledby="flare-ev-h">
+    <div class="sec-head"><div><div class="eyebrow">{% trans "Detecciones" %}</div><h2 id="flare-ev-h">{% trans "Eventos recientes" %}</h2></div></div>
+    {% if flare.events %}
+    <div class="table-wrap flare-table">
+      <table>
+        <thead><tr><th scope="col">{% trans "Inicio (UT)" %}</th><th scope="col">{% trans "Duración" %}</th><th scope="col">{% trans "Prob. máx." %}</th><th scope="col">{% trans "Clase GOES" %}</th><th scope="col">{% trans "Ubicación" %}</th></tr></thead>
+        <tbody>
+          {% for e in flare.events %}
+          <tr><td>{{ e.start|date:"d-M H:i" }}</td><td>{{ e.minutes }} min</td><td>{{ e.p_max|floatformat:2 }}</td><td>{% if e.goes %}<span class="flare-cls flare-cls--{{ e.goes_level }}">{{ e.goes }}</span>{% else %}—{% endif %}</td><td>{{ e.location|default:"—" }}</td></tr>
+          {% endfor %}
+        </tbody>
+      </table>
+    </div>
+    <p class="flare-help">{% trans "Clase GOES: el flujo máximo de rayos X (0,1–0,8 nm) entre 10 minutos antes y 10 minutos después del evento." %}</p>
+    {% else %}
+    <p>{% trans "Sin eventos en los últimos 7 días." %}</p>
+    {% endif %}
+  </section>
+
+  <section class="sec flare-about">
+    <div><div class="eyebrow">{% trans "Cómo leerlo" %}</div><h3>{% trans "Qué detecta" %}</h3><p>{% trans "Un ensemble de 5 redes neuronales compara cada imagen de AIA (131, 171, 304 y 1600 Å) con las de 8 a 12 minutos antes. Sobre 0,80, Centella abre un evento." %}</p></div>
+    <div><div class="eyebrow">{% trans "Desempeño" %}</div><h3>{% trans "Validado contra GOES" %}</h3><p>{% trans "Junio–julio 2026: detectó todas las flares M2 o mayores (22/22) y el 72 % de las M/X, con 3 falsas alarmas en 28 días. La alerta llega típicamente 1 min antes del pico de rayos X." %}</p></div>
+    <div><div class="eyebrow">{% trans "Límites" %}</div><h3>{% trans "Lo que no hace" %}</h3><p>{% trans "No anticipa flares: confirma con imágenes lo que GOES ya empieza a ver y dice dónde ocurre. Pierde M1 pequeñas cuando hay muchas seguidas. Producto en beta." %}</p></div>
+  </section>
+</div>
+{% endblock %}
diff --git a/web/tests/test_flare_page.py b/web/tests/test_flare_page.py
