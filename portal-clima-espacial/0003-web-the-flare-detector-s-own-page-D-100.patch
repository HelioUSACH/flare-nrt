+++ b/web/tests/test_flare_page.py
@@ -0,0 +1,131 @@
+"""The flare detector's own page (web/flare_page.py) and its image proxy.
+Events are synthetic Centella 2.0 payloads published through swxkit, as the
+collector would (modules/flare)."""
+
+import datetime as dt
+
+import httpx
+import pytest
+from django.core.cache import cache
+from django.test import Client
+from django.urls import reverse
+from django.utils import timezone
+
+from core import swxkit
+from web import flare_page
+
+PID = "usach.flare.nrt"
+
+
+@pytest.fixture
+def client():
+    return Client(SERVER_NAME="localhost")
+
+
+def _publish(t, prob, *, alert=False, flare=False, event_id=None, loc=None):
+    swxkit.publish_event(
+        PID,
+        {"probability": prob, "flare_detected": flare, "location": loc, "alert": alert, "event_id": event_id},
+        valid_from=t, issued=t + dt.timedelta(minutes=12),
+        quality={"producer_live_status": "live", "model_version": "2.0.0", "data_latency_s": 720},
+    )
+
+
+def _xray(t0, n, flux_at):
+    swxkit.publish_timeseries("noaa.goes.xray", [
+        {"time_tag": (t0 + dt.timedelta(minutes=i)).strftime("%Y-%m-%dT%H:%M:%SZ"),
+         "flux": flux_at(i), "energy": "0.1-0.8nm", "satellite": 19} for i in range(n)])
+
+
+def _fixture_day(open_event=False):
+    now = timezone.now().replace(second=0, microsecond=0)
+    t0 = now - dt.timedelta(hours=3)
+    loc = {"centroid_arcsec": [854.0, 303.0], "on_limb": True, "method": "test", "confidence": "experimental"}
+    _xray(t0, 180, lambda i: 2.4e-4 if 60 <= i <= 66 else 1e-6)
+    for k in range(0, 180, 2):
+        t = t0 + dt.timedelta(minutes=k)
+        in_ev = 60 <= k <= 66 or (open_event and k >= 176)
+        eid = 1 if 60 <= k <= 66 else (2 if in_ev else None)
+        _publish(t, 0.95 if in_ev else 0.1, alert=in_ev, flare=open_event and k >= 176,
+                 event_id=eid, loc=loc if in_ev else None)
+    return now
+
+
