diff --git a/web/flare_page.py b/web/flare_page.py
new file mode 100644
index 0000000..e4e2973
--- /dev/null
+++ b/web/flare_page.py
@@ -0,0 +1,185 @@
+"""The designed page of the flare detector (`usach.flare.nrt`, model
+Centella, D-099): current state, the four AIA channels, the last 24 h of
+probability against the GOES X-ray flux, and recent events.
+
+Everything here reads what the portal already stores — the Centella events
+the collector publishes every 2 min (modules/flare, D-096/D-098) and the
+`noaa.goes.xray` series — except the channel images, which `views.flare_image`
+proxies from Centella (127.0.0.1 only, docs/ARCHITECTURE.md §6). Charts are
+server-rendered SVG paths (no JS), on a 1000 × 200 viewBox."""
+
+from __future__ import annotations
+
+import datetime as dt
+import math
+
+from django.utils import timezone
+
+from core.models import Event, TimeSeriesPoint
+
+CHANNELS = (
+    {"wave": 131, "ion": "Fe VIII · Fe XXI", "what_es": "Plasma de flare, ~10 MK", "what_en": "Flare plasma, ~10 MK"},
+    {"wave": 171, "ion": "Fe IX", "what_es": "Corona tranquila y arcos, ~0,6 MK",
+     "what_en": "Quiet corona and loops, ~0.6 MK"},
+    {"wave": 304, "ion": "He II", "what_es": "Cromósfera y región de transición, ~50 000 K",
+     "what_en": "Chromosphere and transition region, ~50,000 K"},
+    {"wave": 1600, "ion": "C IV + continuo UV", "what_es": "Cromósfera alta: cintas de flare",
+     "what_en": "Upper chromosphere: flare ribbons"},
+)
+W, H = 1000, 200
+WINDOW = dt.timedelta(hours=24)
+GAP = dt.timedelta(minutes=7)        # a missing 2-min slot or two: break the line
+XRAY_ENERGY = "0.1-0.8nm"
+XRAY_LOG_RANGE = (-8.0, -3.0)         # A1 … X10 on the chart's right axis
+EVENT_DAYS = 7
+EVENT_PAD = dt.timedelta(minutes=10)  # GOES peak flux searched in [start − pad, end + pad]
+
+
+def goes_class(flux: float | None) -> str:
+    """1.2e-5 → "M1.2" (NOAA letter scale, one decimal)."""
+    if not flux or flux <= 0:
+        return ""
+    for letter, base in (("X", 1e-4), ("M", 1e-5), ("C", 1e-6), ("B", 1e-7), ("A", 1e-8)):
+        if flux >= base:
+            return f"{letter}{flux / base:.1f}"
+    return "A0.0"
+
+
+def _x(t: dt.datetime, t0: dt.datetime) -> float:
+    return round((t - t0).total_seconds() / WINDOW.total_seconds() * W, 1)
+
+
+def _path(points, t0) -> str:
+    """'M x y x y … M …' with a new subpath after every gap."""
+    out, prev = [], None
+    for t, y in points:
+        if prev is None or t - prev > GAP:
+            out.append("M")
+        out.append(f"{_x(t, t0)} {round(y, 1)}")
+        prev = t
+    return " ".join(out)
+
+
+def _xray_y(flux: float) -> float:
+    lo, hi = XRAY_LOG_RANGE
+    v = min(max(math.log10(flux), lo), hi)
+    return H - (v - lo) / (hi - lo) * H
+
+
+def _location_text(loc: dict | None, lang: str) -> str:
+    if not loc or not loc.get("centroid_arcsec"):
+        return ""
+    x, y = loc["centroid_arcsec"]
+    limb = ""
+    if loc.get("on_limb"):
+        limb = (" · limbo O" if x > 0 else " · limbo E") if lang == "es" else (" · W limb" if x > 0 else " · E limb")
+    return f"{x:+.0f}″, {y:+.0f}″{limb}"
+
+
+def _disk_marker(loc: dict | None) -> dict | None:
+    """Percent position on a square image whose disk spans 86 % of it
+    (rough: the real radius comes from the image itself)."""
+    if not loc or not loc.get("centroid_arcsec"):
+        return None
+    x, y = loc["centroid_arcsec"]
+    r = 960.0
+    return {"left": round(50 + x / r * 43, 1), "top": round(50 - y / r * 43, 1)}
+
+
+def _peak_flux(t0: dt.datetime, t1: dt.datetime) -> float | None:
+    qs = TimeSeriesPoint.objects.filter(product_id="noaa.goes.xray", payload__energy=XRAY_ENERGY,
+                                        time_tag__gte=t0 - EVENT_PAD, time_tag__lte=t1 + EVENT_PAD)
+    vals = [v for v in qs.values_list("payload__flux", flat=True) if isinstance(v, (int, float))]
+    return max(vals) if vals else None
+
+
+def recent_events(product, lang: str, now: dt.datetime) -> list[dict]:
+    rows = (Event.objects.filter(product=product, valid_from__gte=now - dt.timedelta(days=EVENT_DAYS),
+                                 payload__alert=True)
+            .order_by("valid_from").values_list("valid_from", "payload"))
+    events: dict = {}
+    for t, p in rows:
+        eid = p.get("event_id")
+        if eid is None:
+            continue
+        e = events.setdefault(eid, {"id": eid, "start": t, "end": t, "p_max": -1.0, "location": None})
+        e["end"] = t
+        prob = float(p.get("probability") or 0)
+        if prob > e["p_max"]:
+            e["p_max"] = prob
+            e["location"] = p.get("location") or e["location"]
+    out = []
+    for e in sorted(events.values(), key=lambda e: e["start"], reverse=True)[:10]:
+        cls = goes_class(_peak_flux(e["start"], e["end"]))
+        out.append({
+            "start": e["start"], "minutes": int((e["end"] - e["start"]).total_seconds() // 60) + 2,
+            "p_max": e["p_max"], "goes": cls, "goes_level": cls[:1],
+            "location": _location_text(e["location"], lang), "raw_location": e["location"],
+        })
+    return out
+
+
+def flare_context(product, heartbeat_status: str, lang: str, view: str) -> dict:
+    now = timezone.now()
+    t0 = now - WINDOW
+    latest = Event.objects.filter(product=product).order_by("-issued").first()
+    p = latest.payload if latest else {}
+    q = (latest.quality or {}) if latest else {}
+    threshold = 0.80
+    prob = float(p.get("probability") or 0) if latest else None
+
+    if latest is None or heartbeat_status in {"error", "no_data", "pending"}:
+        state = "pending"
+    elif heartbeat_status in {"stale", "delayed"}:
+        state = "stale"
+    elif p.get("flare_detected"):
+        state = "flare"
+    else:
+        state = "quiet"
+
+    probs = (Event.objects.filter(product=product, valid_from__gte=t0)
+             .order_by("valid_from").values_list("valid_from", "payload__probability"))
+    prob_pts = [(t, H - float(v) * H) for t, v in probs if isinstance(v, (int, float))]
+    xray = (TimeSeriesPoint.objects.filter(product_id="noaa.goes.xray", payload__energy=XRAY_ENERGY,
+                                           time_tag__gte=t0)
+            .order_by("time_tag").values_list("time_tag", "payload__flux"))
+    xray_pts = [(t, _xray_y(float(f))) for t, f in xray if isinstance(f, (int, float)) and f > 0]
+
+    events = recent_events(product, lang, now)
+    open_event = events[0] if events and state == "flare" else None
+    ticks = []
+    for h in range(0, 25, 6):
+        t = t0 + dt.timedelta(hours=h)
+        ticks.append({"left": round(h / 24 * 100, 2), "label": f"{t:%H:%M}"})
+    lo, hi = XRAY_LOG_RANGE
+    xray_levels = [{"label": letter, "top": round((hi - math.log10(base)) / (hi - lo) * 100, 1)}
+                   for letter, base in (("X", 1e-4), ("M", 1e-5), ("C", 1e-6), ("B", 1e-7))]
+    event_marks = [{"left": round(_x(e["start"], t0) / W * 100, 2), "label": e["goes"] or f"p {e['p_max']:.2f}"}
+                   for e in events if e["start"] >= t0]
+    channels = [{**c, "what": c["what_es"] if lang == "es" else c["what_en"]} for c in CHANNELS]
+    return {
+        "flare": {
+            "state": state,
+            "observed": latest.valid_from if latest else None,
+            "probability": prob,
+            "probability_pct": round((prob or 0) * 100, 1),
+            "threshold": threshold,
+            "threshold_pct": threshold * 100,
+            "latency_min": round(q["data_latency_s"] / 60) if q.get("data_latency_s") is not None else None,
+            "model_version": q.get("model_version"),
+            "location": _location_text(p.get("location"), lang),
+            "marker": _disk_marker(p.get("location") or (open_event or {}).get("raw_location")),
+            "open_event": open_event,
+            "last_event": events[0] if events else None,
+            "view": "diff" if view in {"diff", "diferencia"} else "img",
+            "channels": channels,
+            "prob_path": _path(prob_pts, t0),
+            "xray_path": _path(xray_pts, t0),
+            "threshold_y": H - threshold * H,
+            "ticks": ticks,
+            "xray_levels": xray_levels,
+            "event_marks": event_marks,
+            "events": events,
+            "has_series": bool(prob_pts),
+        }
+    }
