+def flare_xray_json(request):
+    """GOES 0.1–0.8 nm flux the portal stores (noaa.goes.xray), for the
+    flare page's timeline: ``start``/``end`` (ISO, ≤ 14 days apart), at most
+    ~2000 points (every n-th minute). Empty for periods the portal has not
+    collected (e.g. an old replayed month)."""
+    try:
+        t0 = dt.datetime.fromisoformat(request.GET["start"].replace("Z", "+00:00"))
+        t1 = dt.datetime.fromisoformat(request.GET["end"].replace("Z", "+00:00"))
+    except (KeyError, ValueError):
+        return JsonResponse({"error": "start and end (ISO 8601) are required"}, status=400)
+    if t0.tzinfo is None or t1.tzinfo is None or not t0 < t1 or t1 - t0 > dt.timedelta(days=14):
+        return JsonResponse({"error": "start < end, UTC, at most 14 days apart"}, status=400)
+    key = f"flare-xray:{t0:%Y%m%d%H%M}:{t1:%Y%m%d%H%M}"
+    data = cache.get(key)
+    if data is None:
+        rows = (TimeSeriesPoint.objects.filter(product_id="noaa.goes.xray", payload__energy=flare_page.XRAY_ENERGY,
+                                               time_tag__gte=t0, time_tag__lte=t1)
+                .order_by("time_tag").values_list("time_tag", "payload__flux"))
+        pts = [[t.strftime("%Y-%m-%dT%H:%M:%SZ"), f] for t, f in rows if isinstance(f, (int, float)) and f > 0]
+        step = max(1, len(pts) // 2000)
+        data = {"energy": flare_page.XRAY_ENERGY, "points": pts[::step]}
+        cache.set(key, data, 60)
+    return JsonResponse(data)
